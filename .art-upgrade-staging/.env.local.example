# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/fih?retryWrites=true&w=majority

# JWT secret — generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_32_plus_char_random_string

# App Base URL (Used for mode switch links and web dashboard)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ─── WhatsApp Meta Cloud API ──────────────────────────────────────────────────
WHATSAPP_VERIFY_TOKEN=any_string_you_choose

# From Meta App dashboard -> App Settings -> Basic -> App Secret
WHATSAPP_APP_SECRET=your_meta_app_secret

# From Meta -> WhatsApp -> API Setup -> Temporary/Permanent Access Token
WHATSAPP_ACCESS_TOKEN=your_permanent_whatsapp_access_token

# From Meta -> WhatsApp -> API Setup -> Phone Number ID
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id

# ─── Cron ─────────────────────────────────────────────────────────────────────
CRON_SECRET=replace_with_random_string

# ─── Seed ─────────────────────────────────────────────────────────────────────
SEED_SECRET=replace_with_random_string
